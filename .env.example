# Telegram: create a bot with @BotFather, then run `python get_chat_id.py`
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Alert when an in-stock 5090 is at or below this price (USD)
TARGET_PRICE=2000

# Seconds between checks. 15 / 90 are safe for running all day; going lower raises the chance of a block.
BESTBUY_INTERVAL=15
AMAZON_INTERVAL=90

# Optional: extra Amazon ASINs to watch directly, comma-separated (the B0... code in an amazon.com/dp/ URL)
AMAZON_ASINS=

# Optional: extra Best Buy SKUs to always watch, comma-separated (the skuId= number in a bestbuy.com URL)
BESTBUY_SKUS=
